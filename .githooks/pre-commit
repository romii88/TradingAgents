#!/bin/sh

set -eu

staged_files=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$staged_files" ]; then
  exit 0
fi

tmp_file=$(mktemp)
trap 'rm -f "$tmp_file"' EXIT

git diff --cached --unified=0 -- $staged_files > "$tmp_file"

while IFS= read -r line; do
  case "$line" in
    +*MOONSHOT_API_KEY=*|+*OPENAI_API_KEY=*|+*GOOGLE_API_KEY=*|+*ANTHROPIC_API_KEY=*|+*XAI_API_KEY=*|+*OPENROUTER_API_KEY=*)
      value=${line#*=}
      trimmed=$(printf '%s' "$value" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
      if [ -z "$trimmed" ] || [ "$trimmed" = "..." ] || [ "$trimmed" = '"..."' ] || [ "$trimmed" = "'...'" ]; then
        continue
      fi
      case "$trimmed" in
        *'${'*|*YOUR_*|*your_*|*\<*)
          ;;
        *)
          echo "Blocked commit: staged changes contain API key assignment lines."
          echo "Move secrets to local env files or shell exports before committing."
          exit 1
          ;;
      esac
      ;;
  esac
done < "$tmp_file"

if grep -E '^\+.*sk-[A-Za-z0-9_-]{20,}' "$tmp_file" >/dev/null; then
  echo "Blocked commit: staged changes contain a token that looks like a secret key."
  echo "Remove the secret from staged changes before committing."
  exit 1
fi

exit 0
